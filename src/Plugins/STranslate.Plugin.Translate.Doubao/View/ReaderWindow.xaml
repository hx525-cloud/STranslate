<Window
    x:Class="STranslate.Plugin.Translate.Doubao.View.ReaderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Translate.Doubao.ViewModel"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Width="1280"
    Height="860"
    MinWidth="800"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=vm:ReaderViewModel}"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <DockPanel Margin="12,8" LastChildFill="False">
            <ikw:SimpleStackPanel
                DockPanel.Dock="Left"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{Binding OpenCommand}"
                    Content="{DynamicResource STranslate_Plugin_Translate_Doubao_Reader_Open}"
                    Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}" />
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource STranslate_Plugin_Translate_Doubao_Doc_TargetLang}" />
                <ComboBox
                    MinWidth="140"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding TargetLanguage}" />
                <CheckBox Content="{DynamicResource STranslate_Plugin_Translate_Doubao_Reader_Mirror}" IsChecked="{Binding ShowMirror}" />
            </ikw:SimpleStackPanel>
            <ikw:SimpleStackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{Binding ExportCancelCommand}"
                    Content="{DynamicResource STranslate_Plugin_Translate_Doubao_Doc_Cancel}"
                    Visibility="{Binding ExportCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Command="{Binding ExportCommand}" Content="{DynamicResource STranslate_Plugin_Translate_Doubao_Reader_Export}" />
            </ikw:SimpleStackPanel>
        </DockPanel>

        <!--  pdf.js 阅读器：左侧原文，右侧镜像对照页（由 bridge.js 在页面内生成）  -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView" />
            <TextBlock
                x:Name="EmptyHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.6"
                Text="{DynamicResource STranslate_Plugin_Translate_Doubao_Reader_Empty}" />
        </Grid>

        <!--  状态栏  -->
        <DockPanel Grid.Row="2" Margin="12,6">
            <Button
                Margin="8,0,0,0"
                Command="{Binding OpenOutputCommand}"
                Content="{DynamicResource STranslate_Plugin_Translate_Doubao_Doc_OpenOutput}"
                DockPanel.Dock="Right"
                Visibility="{Binding HasOutput, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ui:ProgressRing
                Width="16"
                Height="16"
                Margin="0,0,8,0"
                DockPanel.Dock="Left"
                IsActive="{Binding IsTranslating}"
                Visibility="{Binding IsTranslating, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ProgressBar
                Width="160"
                Height="4"
                Margin="8,0,0,0"
                DockPanel.Dock="Right"
                Maximum="100"
                Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                Value="{Binding ExportProgress}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
